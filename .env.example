# Root template — copy thành apps/api/.env và apps/mobile/.env tương ứng

# === apps/api/.env ===
DATABASE_URL=postgresql://pulz:pulz_dev@localhost:5432/pulz_dev
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=3000
CORS_ORIGINS=http://localhost:8081,exp://192.168.1.6:8081

# === apps/mobile/.env ===
# IP LAN của PC chạy BE (không dùng localhost vì iPhone không tới được)
EXPO_PUBLIC_API_URL=http://192.168.1.6:3000/api/v1
