{
  "expo": {
    "name": "PulzApp",
    "slug": "pulzapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pulzapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0E0E0E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulzapp.app"
    },
    "android": {
      "package": "com.pulzapp.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
