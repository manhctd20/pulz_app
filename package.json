{
  "name": "pulzapp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "shared:build": "npm run build -w @pulz/shared",
    "shared:dev": "npm run dev -w @pulz/shared",
    "mobile": "npm run shared:build && npm run start -w @pulz/mobile",
    "mobile:lan": "npm run shared:build && npm run start -w @pulz/mobile -- --lan",
    "api": "npm run shared:build && npm run start:dev -w @pulz/api",
    "api:build": "npm run build -w @pulz/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w @pulz/api",
    "db:studio": "npm run prisma:studio -w @pulz/api",
    "db:seed": "npm run prisma:seed -w @pulz/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
