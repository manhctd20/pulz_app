# === LOCAL DEV ===
# Copy file này thành `.env`. Giá trị dưới đây OK cho local dev.

DATABASE_URL=postgresql://pulz:pulz_dev@localhost:5432/pulz_dev

# Dev secrets — KHÔNG dùng trong production.
# Production startup sẽ REFUSE khởi động nếu secret chứa các marker "dev-" hoặc "change-me",
# hoặc độ dài < 32 ký tự.
JWT_ACCESS_SECRET=dev-access-secret-please-change-in-production-abcdefghijklmnop
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-in-production-qrstuvwxyz123456

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=3000

# CORS: rỗng → fallback dev cho phép localhost + LAN 192.168.*/10.*.*.* + exp://
# Production: BẮT BUỘC khai báo explicit comma-separated origins (không dùng `*`).
CORS_ORIGINS=

# Swagger docs tự động bật ở dev. Trong production set ENABLE_SWAGGER=true nếu muốn expose /docs công khai.
# ENABLE_SWAGGER=false

# Email (Resend). Nếu rỗng → forgot-password chỉ log token vào console (dev mode).
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=hello@yourdomain.com

# === PRODUCTION ===
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@host:5432/dbname?sslmode=require
# Generate strong secrets (chạy 1 lần, copy output):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# JWT_ACCESS_SECRET=<output dòng 1>
# JWT_REFRESH_SECRET=<output dòng 2 — khác secret access>
# CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
